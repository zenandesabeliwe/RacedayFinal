
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>RaceDay</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <!-- Navigation bar -->
    <nav class="navbar navbar-expand-lg navbar-dark raced-nav">
        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">
                RaceDay
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#raceNav"
                    aria-controls="raceNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="raceNav">

                <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                    <!-- Upcoming races -->
                    <a class="nav-link"
                       asp-controller="Events"
                       asp-action="Index">
                        Upcoming Races
                    </a>

                    <!-- Organiser navigation -->
                    @if (Context.Session.GetString("Role") == "Organiser")
                    {
                        <a class="nav-link"
                           asp-controller="Organiser"
                           asp-action="Index">
                            Dashboard
                        </a>

                        <a class="nav-link"
                           asp-controller="Organiser"
                           asp-action="Create">
                            Create Event
                        </a>
                    }

                    <!-- Participant navigation -->
                    @if (Context.Session.GetString("Role") == "Participant")
                    {
                        <a class="nav-link"
                           asp-controller="Participant"
                           asp-action="MyEnrolments">
                            My Enrolments
                        </a>

                        <a class="nav-link"
                           asp-controller="Participant"
                           asp-action="Results">
                            My Results
                        </a>
                    }

                    <!-- Profile for logged-in users -->
                    @if (Context.Session.GetString("Role") != null)
                    {
                        <a class="nav-link"
                           asp-controller="Profile"
                           asp-action="Index">
                            My Profile
                        </a>
                    }

                    <!-- Login and registration -->
                    @if (Context.Session.GetString("Role") == null)
                    {
                        <a class="nav-link"
                           asp-controller="Account"
                           asp-action="Login">
                            Log In
                        </a>

                        <a class="btn btn-success ms-lg-2"
                           asp-controller="Account"
                           asp-action="Register">
                            Get Started
                        </a>
                    }
                    else
                    {
                        <!-- Logout -->
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">

                            <button class="btn btn-outline-light btn-sm"
                                    type="submit">
                                Log Out
                            </button>
                        </form>
                    }

                </div>
            </div>
        </div>
    </nav>

    <!-- Main page content -->
    <main class="container py-5">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @RenderBody()

    </main>

    <!-- Footer -->
    <footer class="border-top text-center py-4">
        RaceDay • Run your race
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
