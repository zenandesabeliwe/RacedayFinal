<h1>Create account</h1><form method="post" class="form-card">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><label class="form-label">Full name</label><input class="form-control mb-3" name="fullName" required/><label class="form-label">Email</label><input class="form-control mb-3" name="emailAddress" type="email" required/><label class="form-label">Phone number</label><input class="form-control mb-3" name="phoneNumber" required/><label class="form-label">Password</label><input class="form-control mb-3" name="password" type="password" minlength="8" required/><label class="form-label">Role</label><select class="form-select mb-3" name="userRole"><option>Participant</option><option>Organiser</option></select><button class="btn btn-success">Register</button></form>