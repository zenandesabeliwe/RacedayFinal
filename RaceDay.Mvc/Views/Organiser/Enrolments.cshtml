@model JsonElement
<h1>Event @ViewBag.EventID: Enrolments</h1>@if(Model.ValueKind==JsonValueKind.Array){foreach(var e in Model.EnumerateArray()){<div class="card p-3 mb-3"><pre>@e.ToString()</pre>@if(e.TryGetProperty("enrolmentID",out var id)){<form asp-action="RecordResult" method="post"><input type="hidden" name="eventID" value="@ViewBag.EventID"/><input type="hidden" name="enrolmentID" value="@id"/><label>Finish time (HH:MM:SS)<input name="finishTime" class="form-control" placeholder="01:25:30" required/></label><label>Finish position<input name="finishPosition" class="form-control" type="number" min="1" required/></label><button class="btn btn-success mt-2">Record result</button></form>}</div>}}<a asp-action="Index">Back to dashboard</a>