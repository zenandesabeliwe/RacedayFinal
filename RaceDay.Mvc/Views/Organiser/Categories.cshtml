@model JsonElement
<h1>Event @ViewBag.EventID: Categories</h1><form asp-action="AddCategory" method="post" class="card p-3 mb-4"><input type="hidden" name="eventID" value="@ViewBag.EventID"/><h2 class="h5">Add category</h2><label>Category name<input name="categoryName" class="form-control" required/></label><label>Distance (km)<input name="distance" type="number" step="0.01" min="0" class="form-control" required/></label><label>Age<input name="age" type="number" min="0" class="form-control" required/></label><label>Start time<input name="startTime" type="time" class="form-control" required/></label><button class="btn btn-success mt-3">Add category</button></form><h2 class="h5">Existing categories</h2>@if(Model.ValueKind==JsonValueKind.Array){foreach(var c in Model.EnumerateArray()){<div class="card p-3 mb-2"><pre class="mb-2">@c.ToString()</pre>@if(c.TryGetProperty("categoryID",out var id)){<form method="post" asp-action="DeleteCategory"><input type="hidden" name="id" value="@id"/><input type="hidden" name="eventID" value="@ViewBag.EventID"/><button class="btn btn-sm btn-outline-danger">Delete category</button></form>}</div>}}<a asp-action="Index">Back to dashboard</a>