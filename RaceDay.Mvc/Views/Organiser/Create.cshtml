<h1>Create new event</h1><div asp-validation-summary="All" class="text-danger"></div><form method="post" class="card p-4"><label class="form-label">Event name<input name="eventName" required class="form-control" /></label><label class="form-label">Description<textarea name="description" required class="form-control"></textarea></label><label class="form-label">Date<input name="eventDate" type="date" required class="form-control" /></label><label class="form-label">Location<input name="location" required class="form-control" /></label><label class="form-label">Distance (km)<input name="distance" type="number" min="0.01" max="999.99" step="0.01" required class="form-control" /></label><label class="form-label">Event type<select name="eventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option><option>Marathon</option><option>Trail Run</option><option>Fun Run</option></select></label><fieldset class="border rounded p-3 mt-4"><legend class="float-none w-auto px-2 fs-5">First category (optional)</legend><p class="text-muted">Add one category now, or manage multiple categories after creating the event.</p><label class="form-label">Category name<input name="categoryName" class="form-control" placeholder="e.g. 10 km Run" /></label><label class="form-label">Category distance (km)<input name="categoryDistance" type="number" step="0.01" min="0.01" max="999.99" class="form-control" /></label><label class="form-label">Minimum age<input name="categoryAge" type="number" min="0" class="form-control" /></label><label class="form-label">Start time<input name="categoryStartTime" type="time" class="form-control" /></label></fieldset><button class="btn btn-success mt-3">Create event</button></form>