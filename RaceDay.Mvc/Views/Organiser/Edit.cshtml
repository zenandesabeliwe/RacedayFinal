@model JsonElement
<h1>Edit event</h1><form method="post" class="card p-4"><input type="hidden" name="id" value="@Model.GetProperty("eventID")"/><label>Event name<input class="form-control" required name="eventName" value="@Model.GetProperty("eventName").ToString()"/></label><label>Description<textarea class="form-control" required name="description">@Model.GetProperty("description").ToString()</textarea></label><label>Date<input class="form-control" required type="date" name="eventDate" value="@Model.GetProperty("eventDate").ToString().Substring(0,10)"/></label><label>Location<input class="form-control" required name="location" value="@Model.GetProperty("location").ToString()"/></label><label>Distance<input class="form-control" required type="number" min="0.01" max="999.99" step="0.01" name="distance" value="@Model.GetProperty("distance")"/></label><label>Type<select class="form-select" name="eventType">@foreach(var t in new[]{"Run","Walk","Cycle","Marathon","Trail Run","Fun Run"}){<option selected="@(Model.GetProperty("eventType").ToString()==t)">@t</option>}</select></label><button class="btn btn-success mt-3">Save changes</button></form>