@model JsonElement
<h1>My profile</h1>@if(Model.ValueKind==JsonValueKind.Object){<p><strong>Email:</strong> @Model.GetProperty("emailAddress").ToString()</p><p><strong>Role:</strong> @Model.GetProperty("userRole").ToString()</p><form method="post" asp-action="Update" class="card p-4"><label>Full name<input name="fullName" required class="form-control" value="@Model.GetProperty("fullName").ToString()"/></label><label>Phone number<input name="phoneNumber" required class="form-control" value="@Model.GetProperty("phoneNumber").ToString()"/></label><button class="btn btn-success mt-3">Update profile</button></form>}